{
  "name": "users",
  "version": "1.0.0",
  "description": "express/graphql learnings",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "npm-run-all --parallel json:server start",
    "start": "nodemon --exec ts-node server.ts",
    "json:server": "json-server --watch db.json",
    "check-format": "npm run pretty -- --list-different",
    "commit": "npx git-cz",
    "format": "npm run pretty -- --write",
    "lint": "eslint --ignore-path .gitignore --ext .ts .",
    "pretty": "prettier --ignore-path .gitignore \"**/*.+(ts|json|md)\"",
    "validate": "npm-run-all --parallel check-format lint build"
  },
  "author": "Lenny Peters <@loonz206>",
  "license": "ISC",
  "devDependencies": {
    "@commitlint/cli": "^17.6.1",
    "@commitlint/config-conventional": "^17.6.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.39.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-security": "^1.7.1",
    "eslint-plugin-sonarjs": "^0.19.0",
    "express": "^4.22.1",
    "express-graphql": "^0.12.0",
    "graphql": "^15.3.0",
    "husky": "^8.0.3",
    "lint-staged": "^13.2.2",
    "lodash": "^4.17.23",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.8.8",
    "ts-node": "^10.9.2",
    "typescript": "~5.5.4"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "dotenv": "^17.3.1",
    "json-server": "^0.17.4",
    "nodemon": "^3.1.14"
  },
  "overrides": {
    "flatted": "^3.4.2",
    "micromatch": "^4.0.8"
  }
}
